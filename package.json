  "repository": {
    "type": "git",
    "url": "https://github.com/FahadNiz/lexidata.git"
  },
  "bugs": {
    "url": "https://github.com/FahadNiz/lexidata/issues"
  },
  "homepage": "https://github.com/FahadNiz/lexidata",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
