{
  "name": "lexidata",
  "version": "1.0.0",
  "description": "Open lexical data and a REST API for English words, definitions, senses, examples, pronunciations, and search.",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
